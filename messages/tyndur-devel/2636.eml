* Die Funktion syscall_rpc ruft einen Syscall auf, welcher nicht mehr
  durch den Kernel unterstuetzt wird. Die Funktion kann daher entfernt
  werden.

Signed-off-by: Nico Mayer <mayerNico256@gmail.com>
---
 src/modules/lib/syscalls/rpc.c | 9 ---------
 1 file changed, 9 deletions(-)

diff --git a/src/modules/lib/syscalls/rpc.c b/src/modules/lib/syscalls/rpc.c
index 94acde16..a1b93a38 100644
--- a/src/modules/lib/syscalls/rpc.c
+++ b/src/modules/lib/syscalls/rpc.c
@@ -31,15 +31,6 @@
 #include <errno.h>
 #include "syscallx.h"
 
-void rpc(pid_t pid)
-{
-    uint32_t result = 0;
-
-    do {
-        SYSCALL2(SYSCALL_RPC, pid, 0, result);
-    } while (result != 0);
-}
-
 int send_message(pid_t pid, uint32_t function, uint32_t correlation_id,
     uint32_t len, char* data)
 {
-- 
