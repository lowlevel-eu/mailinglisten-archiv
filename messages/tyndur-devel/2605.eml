-        // versuchen.
-        if (do_fastrpc(item->task->pid,
-                4, (char*) &rpc_timer_function,
-                4, (char*) &item->timer_id, false))
-        {
-            i++;
-            continue;
-        }
-
-        free(list_remove(timers, i));
-    }
-
-    last_microtime =3D microtime;
-}
