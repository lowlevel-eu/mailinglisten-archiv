-    static uint64_t last_microtime =3D 0;
-    static const uint32_t rpc_timer_function =3D 514;
-
-    struct timeout* item;
-    int i =3D 0;
-    while ((item =3D list_get_element_at(timers, i)))
-    {
-        // Die Schleife soll nur so lange laufen, wie die Timeouts in der
-        // Vergangenheit liegen. Da die Liste sortiert ist, kann beim erst=
