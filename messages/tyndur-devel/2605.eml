-    // PIT initialisieren
-    reload_value =3D 1193182 / CONFIG_TIMER_HZ;
-    outb(0x43, PIT_COUNTER_0 | PIT_RW_FULL | PIT_MODE_2_RATE_GEN);
-    outb(0x40, reload_value & 0xff);
-    outb(0x40, reload_value >> 8);
