-    struct timeout* timeout =3D malloc(sizeof(struct timeout));
-
-    timeout->task       =3D task;
-    timeout->timer_id   =3D timer_id;
-    timeout->timeout    =3D timer_ticks + usec;
-
-    // An der richtigen Stelle in der Liste einsortieren, so dass immer nu=
r
-    // das erste Listenelement geprueft werden muss
-    struct timeout* item;
-    int i;
-    for (i =3D 0; (item =3D list_get_element_at(timers, i)); i++) {
-        if (item->timeout > timeout->timeout) {
-            break;
-        }
-    }
-
-    list_insert(timers, i, timeout);
-}
