+/**
+ * Prueft ob die Annahme stimmt. Falls sie das nicht tut, wird mit einer
+ * Fehlermeldung abgebrochen.
+ */
+void _assert(const char* assertation, int expression)
+{
+    if (!expression) {
+        fprintf(stderr, "Annahme fehlgeschlagen: %s\n", assertation);
+    }
+}
