 void set_io_bitmap()
 {
+    tss.io_bit_map_offset = TSS_IO_BITMAP_OFFSET;
+
     if (current_task->io_bitmap) {
         memcpy(tss.io_bit_map, current_task->io_bitmap, IO_BITMAP_LENGTH / 8);
     } else {
