<refentry id="sh" lang="de">

<refnamediv>
    <refname>echo</refname>
    <refpurpose>
        Gibt nachfolgenden Text aus
    </refpurpose>
</refnamediv>

<refsynopsisdiv>
    <cmdsynopsis>
        <command>echo</command>
        <arg choice="req"><replaceable>Auszugebender Text</replaceable></arg>
    </cmdsynopsis>
</refsynopsisdiv>

<refsection>
    <title>Beschreibung</title>
    <para>
        echo Gibt allen Text aus, welches als Parameter übergeben wird.
        <itemizedlist>
            <listitem>
                echo Hallo gibt also 'Hallo' aus
            </listitem>
        </itemizedlist>
    </para>
</refsection>

<refsection>
    <title>Siehe auch</title>
    <para><olink targetdoc="cat" targetptr="">cat</olink></para>
</refsection>

</refentry>