<refentry id="sh" lang="de">

<refnamediv>
    <refname>pwd</refname>
    <refpurpose>
        Anzeigen des aktuellen Verzeichnispfades
    </refpurpose>
</refnamediv>

<refsynopsisdiv>
    <cmdsynopsis>
        <command>ls</command>
    </cmdsynopsis>
</refsynopsisdiv>

<refsection>
    <title>Beschreibung</title>
    <para>
        Per pwd wird der aktuelle Verzeichnispfad auf dem Bildschirm ausgegeben.
    </para>
</refsection>

<refsection>
    <title>Siehe auch</title>
    <para><olink targetdoc="pwd" targetptr="">ls</olink></para>
    <para><olink targetdoc="cd" targetptr="">cd</olink></para>
</refsection>

</refentry>