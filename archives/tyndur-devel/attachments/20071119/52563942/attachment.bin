+function DirectoryExists(const Directory: AnsiString) : Boolean;
+var
+    handle: longint;
+    cDirName: String;
 begin
-    Result := true; // FIXME
+    cDirName := Directory + #0;
+    handle := c_opendir(@cDirName[1]);
+    
+    DirectoryExists := handle <> 0;
+    if DirectoryExists then begin
+        c_closedir(handle);
+    end;
 end;
 
