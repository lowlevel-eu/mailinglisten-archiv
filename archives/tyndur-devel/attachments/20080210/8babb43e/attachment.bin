Index: src/include/ports.h
===================================================================
--- src/include/ports.h	(Revision 702)
+++ src/include/ports.h	(Arbeitskopie)
@@ -1,53 +1,90 @@
-#ifndef PORTS_H
-#define PORTS_H
+/*  
