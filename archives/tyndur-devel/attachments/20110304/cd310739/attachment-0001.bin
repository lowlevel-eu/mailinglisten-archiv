From b0b57150307875ac4f3deae60dab74303003acf5 Mon Sep 17 00:00:00 2001
From: Stefan <stefan0stefan26@googlemail.com>
Date: Fri, 4 Mar 2011 19:39:17 +0100
Subject: [PATCH] Installer um Tyndur zu installieren
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

+ Tyndur lässt sich nun installieren
Signed-off-by: Stefan <stefan0stefan26@googlemail.com>
---
 src/modules/c/install/Makefile     |   45 ++++++++++++++
 src/modules/c/install/Makefile.all |    8 +++
 src/modules/c/install/install      |  Bin 0 -> 222727 bytes
 src/modules/c/install/main.c       |  115 ++++++++++++++++++++++++++++++++++++
 src/modules/c/install/main.o       |  Bin 0 -> 7272 bytes
 5 files changed, 168 insertions(+), 0 deletions(-)
 create mode 100644 src/modules/c/install/Makefile
 create mode 100644 src/modules/c/install/Makefile.all
 create mode 100755 src/modules/c/install/install
 create mode 100644 src/modules/c/install/main.c
 create mode 100644 src/modules/c/install/main.o

diff --git a/src/modules/c/install/Makefile b/src/modules/c/install/Makefile
new file mode 100644
index 0000000..3de43f9
--- /dev/null
+++ b/src/modules/c/install/Makefile
@@ -0,0 +1,45 @@
+-include /home/stefan/tyndur/Makefile.local
+
+CC=$(CC_BINARY)  -I ../../include -I ../../../include/arch/i386 -I ../../../include 
+CPP=$(CPP_BINARY) -I ../../include -I ../../../include/arch/i386 -I ../../../include
+PPC=$(PPC_BINARY) -n -Cn -CX -Ttyndur -Fi../../include -Fi../../../include/arch/i386 -Fi../../../include -Fu../lib/units -Fu../units
+
+ASM_ELF=nasm -felf -O99 -I ../../include/ -I ../../../include/arch/i386/ -I ../../../include/
+ASM_BIN=nasm -fbin -O99
+
+BUILD_DIR=$(BUILD_ROOT)/src/modules/c/install
+
+AS=$(AS_BINARY)
+
+all:
+	$(MAKE) --no-print-directory -s makefiles
+	$(MAKE) --no-print-directory -s subdirs
+	$(MAKE) --no-print-directory -s obj 
+	LOST_BUILDMK_ROOT=/home/stefan/tyndur LDSCRIPT='-T /home/stefan/tyndur/src/modules/user-i386.ld' bash Makefile.all $(BUILD_ROOT) '/home/stefan/tyndur/src/modules/lib/library.a /home/stefan/tyndur/src/modules/lib/crt0.o /home/stefan/tyndur/src/lib/library.a /usr/lib/gcc/i486-linux-gnu/4.4.3/libgcc.a' '/home/stefan/tyndur'
+
+makefiles:
+	if [ -f buildmk.sh ]; then bash ./buildmk.sh; fi
+
+pwdline:
+	echo
+	echo '---- /home/stefan/tyndur/src/modules/c/install'
+
+obj: pwdline main.o
+
+subdirs:
+
+main.o: main.c
+	echo 'CC   main.c:  '
+	$(CC) main.c
+
+clean_objs:
+	rm -f *.o *.a *.mod *.ppu link.res ppas.sh install
+
+softclean: clean_objs
+	for file in *; do if [ -f "$$file/Makefile" -a \( ! -f "$$file/.nobuild" -o -f "$$file/.ignorenobuild" \) ]; then $(MAKE) -sC "$$file" softclean; fi done
+
+clean: clean_objs
+	for file in *; do if [ -f "$$file/Makefile" -a \( ! -f "$$file/.nobuild" -o -f "$$file/.ignorenobuild" \) ]; then $(MAKE) -sC "$$file" clean; rm "$$file/Makefile"; fi done
+	rm -f Makefile.local
+
+.SILENT: all makefiles subdirs obj lbuilds-env enable-pascal disable-pascal clean softclean clean_objs clean_root updateroot image-floppy image-hd test-qemu test-qemu-hd
diff --git a/src/modules/c/install/Makefile.all b/src/modules/c/install/Makefile.all
new file mode 100644
index 0000000..2411281
--- /dev/null
+++ b/src/modules/c/install/Makefile.all
@@ -0,0 +1,8 @@
+shopt -s extglob
+source $LOST_BUILDMK_ROOT/config.sh
+
+echo "LD   $1/apps/install"
+
+$LOST_TOOLS_LD -oinstall $LDSCRIPT --start-group *.o $2 --end-group
+
+$LOST_TOOLS_STRIP -s install -o $1/apps/install
diff --git a/src/modules/c/install/install b/src/modules/c/install/install
new file mode 100755
index 0000000000000000000000000000000000000000..4ec830fcd090b804650f3dc237ee495deeb25118
GIT binary patch
