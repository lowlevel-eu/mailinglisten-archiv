+++ trunk/src/include/lost/config.h
@@ -0,0 +1,85 @@
+/*  
+ * Copyright (c) 2006 The LOST Project. All rights reserved.
+ *
+ * This code is derived from software contributed to the LOST Project
+ * by Andreas Klebinger.
