Index: src/modules/include/signal.h
===================================================================
--- src/modules/include/signal.h	(Revision 0)
+++ src/modules/include/signal.h	(Revision 0)
@@ -0,0 +1,127 @@
+/*  
+ * Copyright (c) 2007 The LOST Project. All rights reserved.
+ *
+ * This code is derived from software contributed to the LOST Project
+ * by Antoine Kaufmann.
