+ *    notice, this list of conditions and the following disclaimer.
+ * 2. Redistributions in binary form must reproduce the above copyright
+ *    notice, this list of conditions and the following disclaimer in the
+ *    documentation and/or other materials provided with the distribution.
+ * 3. All advertising materials mentioning features or use of this software
+ *    must display the following acknowledgement:
+ *     This product includes software developed by the tyndur Project
+ *     and its contributors.
+ * 4. Neither the name of the tyndur Project nor the names of its
+ *    contributors may be used to endorse or promote products derived
+ *    from this software without specific prior written permission.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS
+ * ``AS IS'' AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED
+ * TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
+ * PURPOSE ARE DISCLAIMED.  IN NO EVENT SHALL THE COPYRIGHT HOLDERS OR
+ * CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL,
+ * EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
+ * PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
+ * OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
+ * WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
+ * OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
+ * ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include <stdio.h>
+#include <unistd.h>
+#include <stdlib.h>
+#include <string.h>
+#include <readline/readline.h>
+#include <wchar.h>
+#include <ctype.h>
+#include <stdbool.h>
+
+void ausgabe (int,bool);
+
+char* loesung;
+
+int main(int argc, char** argv)
+{
+    /*
+     * 	Variabeln
+     */
+    char striche[100];
+    char* eing;
+    int versuch = 11;
+    int i = 0;
+    int z;
+    int k;
+    int c = 0;
+    int l;
+    bool treffer;
+    ////////////////////
+
+    /*
+     * Regeln ausgeben
+     */
+    printf("Hangman!\n");
+    printf("Regeln:\n- keine Zeichen z.B. Ausrufezeichen\n");
+    printf("- nicht mehr als 20 Buchstaben\n");
+    printf("- Beim raten immer nur einen Buchstaben eingeben\n");
+    printf("- Keine Umlaute!\n");
+
+    /*
+     * Wort einlesen, ueberpruefen ob ueberhaupt ein Wort eingegeben wurde
+     * gegebenenfalls das Programm beenden (kann noch verbessert werden :-))
+     * Wort in Kleinbuchstaben umwandeln
+     */
+    loesung = readline("Bitte ein Wort eingeben: ");
+
+    l = strlen(loesung);
+
+    if(loesung == NULL || l < 1) {
+        printf("Sie muessen ein Wort eingeben!\n");
+        return 1;
+    }
+
+    while(c < l + 1) {
+        loesung[c]=tolower(loesung[c]);
+        c++;
+    }
+    //////////////////////////////////
+
+    /*
+     * Bildschirm leeren.
+     */
+
+    puts("\33[2J\33[H");
+
+    /*
+     * Das Wort 'verschluesseln'
+     */
+
+    while (i<=strlen(loesung)) { 
+        striche[i]=45;
+        i++;
+    }
+
+    striche[strlen(loesung)]='\0';
+
+    /////////////////////////////////
+
+    printf("Du hast 11 Versuche!\n");
+    printf("Auf das Raten fertig los!\n\n");
+    printf(striche);
+    printf("\n");
+
+    /*
+     * Schleife, die 11 mal durchlaufen wird --> 11 Versuche
+     */
+
+    for(z=1; z < 12;) {
+        /*
+         * Methode 'ausgabe(int versuch1, bool a)' ausführen
+         */
+        ausgabe(versuch,0);
+
+        treffer = false;
+
+        /*
+         * Versuch einlesen und ueberpruefen ob etwas eingegeben wurde
+         * und ob die Eingabe = der Loesung ist.
+         * Sonst wird der eingegebene Buchstabe 'entschluesselt'
+         * und spaeter auch angezeigt.
+         */
+        eing = readline("Dein Versuch: ");
+
+        k = strlen(eing);
+
+        if ((k > 1 && strcmp(loesung,eing) != 0) || eing == NULL) {
+            printf("Ungueltige Eingabe\n\n");
+            return 1;
+        }
+        else {
+            printf("\n");
+
+            for(i=0; i<=l; i++) {
+                for(k=0; k<strlen(eing); k++) {
+                    if (loesung[i]==eing[k]) {
+                        striche[i]=loesung[i];
+                        treffer=true;
+                    }
+                }
+            }
+        }
+
+        /*
+         * Wenn man nicht richtig liegt hat man einen Versuch weniger.
+         */
+
+        if (treffer==false) {
+            z++;
+            versuch--;
+        }
+
+        /*
+         * Ausgabe des 'verschluesselten' bzw. teilweise 'entschluesselten' Wortes
+         */
+        printf("\n");
+        printf(striche);
+        printf("\n\n");
+
+        /*
+         * Bei Erfolg wird die Schleife unterbrochen und eine schöne Nachricht ausgegeben.
+         */
+
+        if (strcmp (loesung,striche)==0 || strcmp(loesung,eing)==0 ) {
+            printf("Glueckwunsch\n\n");
+            printf(striche);
+            printf("  war die Loesung\n\n");
+            break;
+        }
+    }
+
+    /*
+     * Funktion 'ausgabe' ein letztes Mal aufgerufen.
+     * 'eing' und 'loesung' freigegeben.
+     */
+    ausgabe(versuch,1);
+    free(eing);
+    free(loesung);
+
+    // Programm erfolgreich beenden.
+    return 0;
+}
+
+void ausgabe(int versuch1, bool a)
+{
+    /*
+     * Anzahl der Versuche ueberpruefen + Hangman ausgeben
+     */
+    if(a == 0)
+    {
+        switch (versuch1)
+        {
+            case 11:
+                printf("               \n");
+                printf("               \n");
+                printf("               \n");
+                printf("               \n");
+                printf("               \n");
+                printf("               \n");
+                break;
+            case 10:
+                printf("               \n");
+                printf("               \n");
+                printf("               \n");
+                printf("               \n");
+                printf("               \n");
+                printf("     _|_       \n");
+                break;
+            case 9:
+                printf("               \n");
+                printf("      |        \n");
+                printf("      |        \n");
+                printf("      |        \n");
+                printf("      |        \n");
+                printf("     _|_       \n");
+                break;
+            case 8:
+                printf("      _______  \n");
+                printf("      |        \n");
+                printf("      |        \n");
+                printf("      |        \n");
+                printf("      |        \n");
+                printf("     _|_       \n");
+                break;
+            case 7:
+                printf("      _______  \n");
+                printf("      |/       \n");
+                printf("      |        \n");
+                printf("      |        \n");
+                printf("      |        \n");
+                printf("     _|_       \n");
+                break;
+            case 6:
+                printf("      _______  \n");
+                printf("      |/    |  \n");
+                printf("      |        \n");
+                printf("      |        \n");
+                printf("      |        \n");
+                printf("     _|_       \n");
+                break;
+            case 5:
+                printf("      _______  \n");
+                printf("      |/    |  \n");
+                printf("      |     O  \n");
+                printf("      |        \n");
+                printf("      |        \n");
+                printf("     _|_       \n");
+                break;
+            case 4:
+                printf("      _______  \n");
+                printf("      |/    |  \n");
+                printf("      |     O  \n");
+                printf("      |     |  \n");
+                printf("      |        \n");
+                printf("     _|_       \n");
+                break;
+            case 3:
+                printf("      _______  \n");
+                printf("      |/    |  \n");
+                printf("      |     O/ \n");
+                printf("      |     |  \n");
+                printf("      |        \n");
+                printf("     _|_       \n");
+                break;
+            case 2:
+                printf("      _______  \n");
+                printf("      |/    |  \n");
+                printf("      |     O/ \n");
+                printf("      |    /|  \n");
+                printf("      |        \n");
+                printf("     _|_       \n");
+                break;
+            case 1:
+                printf("      _______  \n");
+                printf("      |/    |  \n");
+                printf("      |     O/ \n");
+                printf("      |    /|  \n");
+                printf("      |    /   \n");
+                printf("     _|_       \n");
+                break;
+            case 0:
+                printf("      _______  \n");
+                printf("      |/    |  \n");
+                printf("      |     O/ \n");
+                printf("      |    /|  \n");
+                printf("      |    / L \n");
+                printf("     _|_       \n");
+                break;
+        }
+    }
+    /*
+     * Loesung anzeigen wenn man es nicht in 11 Versuche geschafft hat. Sonst 'Glueckwunsch!'
+     */
+    if(versuch1 > 0 && a == 1) {
+        printf("Glueckwunsch!\n");
+    }
+    if(versuch1 <= 0) {
+        printf("Du Idiot das waere die Loesung gewesen: ");
+        printf(loesung);
+        printf("\n");
+    }
+}
\ No newline at end of file
-- 
1.7.1

