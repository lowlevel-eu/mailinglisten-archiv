+
+#include <syscall.h>
+
+void* get_phys_addr(void* address)
+{
+    void* ptr;
+
+    asm(
+        "pushl %2;"
+        "mov %1, %%eax;"
+        "int $0x30;"
+        "add $0x8, %%esp;"
+    : "=a" (ptr) : "i" (SYSCALL_MEM_RESOLVE_VADDR), "r" (address));
+
+    return ptr;
+}

