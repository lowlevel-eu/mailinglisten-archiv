+procedure CfgAddlib(path, pubname: String);
+begin
+    path := path + #0;
+    pubname := 'file:/system/lib/' + pubname + #0;
+
+    mkpath('file:/system/lib/');
+    c_lostio_create_link(@path[1], @pubname[1], False);
+end;
