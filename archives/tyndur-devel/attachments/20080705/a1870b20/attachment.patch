 void cpuid(dword* eax, dword* ebx, dword* ecx, dword* edx)
 {
+    // Fix eine Warnung mit gcc 4.3.1
+    *eax = *ebx = *ecx = *edx = 0;
     asm volatile("cpuid"
         : "=a"(*eax), "=b"(*ebx), "=c"(*ecx), "=d"(*edx)
         : "a"(*eax), "b"(*ebx), "c"(*ecx), "d"(*edx)
