         if (!strncmp(item->src, path, MIN(item->src_len, path_len))) {
             size_t dst_len = strlen(item->dst);
-            char new_request[1 + path_len + dst_len];
+            char new_request[1 + path_len + dst_len + 1];
             char* new_path = &new_request[1];
