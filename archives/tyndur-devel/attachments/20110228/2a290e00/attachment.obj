From 753f8ddc7877b97ca105dcb723c2e8b06d5d6fca Mon Sep 17 00:00:00 2001
From: DoBi <DoBi-tyndur@gmx.net>
Date: Mon, 28 Feb 2011 21:45:07 +0100
Subject: [PATCH] Hangman ueberarbeitet
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

* Lizenz hinzugef√ºgt
! Am Ende char* 's freigegeben
* Zeichenbegrenzung entfrent
Signed-off-by: DoBi <DoBi-tyndur@gmx.net>
---
 src/modules/c/hangman/Makefile.all |    8 +
 src/modules/c/hangman/main.c       |  255 ++++++++++++++++++++++++++++++++++++
 2 files changed, 263 insertions(+), 0 deletions(-)
 create mode 100755 src/modules/c/hangman/Makefile.all
 create mode 100755 src/modules/c/hangman/main.c

diff --git a/src/modules/c/hangman/Makefile.all b/src/modules/c/hangman/Makefile.all
new file mode 100755
index 0000000..0ae2b38
--- /dev/null
+++ b/src/modules/c/hangman/Makefile.all
@@ -0,0 +1,8 @@
+shopt -s extglob
+source $LOST_BUILDMK_ROOT/config.sh
+
+echo "LD   $1/apps/hangman"
+
+$LOST_TOOLS_LD -ohangman $LDSCRIPT --start-group *.o $2 --end-group
+
+$LOST_TOOLS_STRIP -s hangman -o $1/apps/hangman
diff --git a/src/modules/c/hangman/main.c b/src/modules/c/hangman/main.c
new file mode 100755
index 0000000..67d678b
--- /dev/null
+++ b/src/modules/c/hangman/main.c
@@ -0,0 +1,255 @@
