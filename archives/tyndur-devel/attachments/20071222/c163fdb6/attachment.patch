+
+// Geraet => Speicher
+#define CDI_DMA_MODE_READ           (1 << 2)
+// Speicher => Geraet
+#define CDI_DMA_MODE_WRITE          (2 << 2)
+#define CDI_DMA_MODE_ON_DEMAND      (0 << 6)
+#define CDI_DMA_MODE_SINGLE         (1 << 6)
+#define CDI_DMA_MODE_BLOCK          (2 << 6)
+
