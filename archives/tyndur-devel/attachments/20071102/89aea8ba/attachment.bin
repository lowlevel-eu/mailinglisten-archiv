Index: lib/stdlibc/directory.c
===================================================================
--- lib/stdlibc/directory.c	(Revision 608)
+++ lib/stdlibc/directory.c	(Arbeitskopie)
@@ -82,3 +82,13 @@
     return TRUE;
 }
 
+bool is_directory(const char* dirname)
+{
+    io_resource_t* dir = directory_open(dirname);
+    if (dir != NULL) {
+        directory_close(dir);
+        return TRUE;
+    } else {
+        return FALSE;
+    }
+}
