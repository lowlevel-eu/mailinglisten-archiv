+
 if [ -z $LOST_BUILDMK_ROOT ]; then
   export LOST_BUILDMK_ROOT="`pwd`"
 fi
@@ -59,20 +60,21 @@
 
 if [ -d lib ]; then
     if [ -f lib/prt0.asm ]; then
-        LIBDIRS="lib/prt0.o $LIBDIRS"
