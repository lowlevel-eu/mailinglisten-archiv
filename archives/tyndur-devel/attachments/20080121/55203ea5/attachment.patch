 fi
 
 CC_FLAGS=
+CC_FLAGS_APPEND=
 if [ -f Makefile.conf ]; then
     source Makefile.conf
 fi
 
 cat <<EOF > Makefile
-CC=$LOST_TOOLS_GCC $CC_FLAGS $INCLUDES
