+    Function LOSTPathExists (F : String) : Boolean;
+      Var
+        cfilename: String;
+        cmode: String;
+        I: longint;
+      begin
+        cfilename := F + #0;
+        cmode := 'r'#0;
+        I := c_fopen(@cfilename[1], @cmode[1]);
