From ebf1aad5ced04ff40e68646e37108ffb368d302b Mon Sep 17 00:00:00 2001
From: Christian Klahn <christian@Christian-Laptop.(none)>
Date: Wed, 5 Jan 2011 22:28:14 +0100
Subject: [PATCH] GRUB2 HD Image umount Fehler behoben
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

! das Script zum erstellen eines GRUB2 HD images gibt jetzt keinen Fehler mehr beim löschen des Mountpointes für das image aus. Ursache war ein nicht ganz abgeschlossener Zugriff auf den Mountpoint
Signed-off-by: Christian Klahn <christian@Christian-Laptop.(none)>
---
 build/scripts/grub2_hd |    1 +
 1 files changed, 1 insertions(+), 0 deletions(-)

diff --git a/build/scripts/grub2_hd b/build/scripts/grub2_hd
index b014a19..5586415 100755
--- a/build/scripts/grub2_hd
+++ b/build/scripts/grub2_hd
@@ -131,6 +131,7 @@ EOF
 fi
 
 # Partition unmounten und loopback-Device freigeben
+sleep 1
 $SUDO umount $MOUNT
 rmdir $MOUNT
 
-- 
1.7.1

