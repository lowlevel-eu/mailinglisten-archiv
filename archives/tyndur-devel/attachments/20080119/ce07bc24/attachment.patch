+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+/**
+ * Wenn die uebergebene Bedingung nicht erfuellt wird, wird das Programm
+ * mit einer Fehlermeldung abgebrochen.
+ */
+void _assert(const char* assertion, const char* file, int line,
+    int expression)
+{
+    if (!expression) {
+        fprintf(stderr, "Zusicherung fehlgeschlagen: '%s' in '%d' auf Zeile %d"
+            "\n", assertion, file, line);
+        abort();
+    }
+}
+
