From 1667800caa17a92ee3031c91fb6b7ff4f1e432b5 Mon Sep 17 00:00:00 2001
From: DoBi <DoBi-tyndur@gmx.net>
Date: Tue, 1 Mar 2011 21:47:44 +0100
Subject: [PATCH] Hangman kommentiert

* Hangman: Kommentare zur besserem Codeverstaendnis
! Hangman: Kleine Aenderungen an den if-Abfragen
Signed-off-by: DoBi <DoBi-tyndur@gmx.net>
---
 src/modules/c/hangman/main.c |   93 +++++++++++++++++++++++++++++++++--------
 1 files changed, 75 insertions(+), 18 deletions(-)

diff --git a/src/modules/c/hangman/main.c b/src/modules/c/hangman/main.c
index 67d678b..67eee37 100755
--- a/src/modules/c/hangman/main.c
+++ b/src/modules/c/hangman/main.c
@@ -48,6 +48,9 @@ char* loesung;
 
 int main(int argc, char** argv)
 {
+	/*
+	 * 	Variabeln
+	 */
 	char striche[100];
 	char* eing;
 	int versuch = 11;
@@ -57,10 +60,19 @@ int main(int argc, char** argv)
 	int c = 0;
 	int l;
 	bool treffer;
+	////////////////////
 	
+	/*
+	 * Regeln ausgeben
+	 */
 	printf("Hangman!\n");
 	printf("Regeln:\n- keine Zeichen z.B. Ausrufezeichen\n- nicht mehr als 20 Buchstaben\n- Beim raten immer nur einen Buchstaben eingeben\n-Keine Umlaute!\n");
 	
+	/*
+	 * Wort einlesen, ueberpruefen ob ueberhaupt ein Wort eingegeben wurde
+	 * gegebenenfalls das Programm beenden (kann noch verbessert werden :-))
+	 * Wort in Kleinbuchstaben umwandeln
+	 */
 	loesung = readline("Bitte ein Wort eingeben: ");
 	
 	l = strlen(loesung);
@@ -76,9 +88,18 @@ int main(int argc, char** argv)
 		loesung[c]=tolower(loesung[c]);
 		c++;
 	}
+	//////////////////////////////////
+	
+	/*
+	 * Bildschirm leeren.
+	 */
 	
 	puts("\33[2J\33[H");
 	
+	/*
+	 * Das Wort 'verschluesseln'
+	 */
+	 
 	while (i<=strlen(loesung)) { 
 		striche[i]=45; 
 		i++; 
@@ -86,18 +107,34 @@ int main(int argc, char** argv)
 	
 	striche[strlen(loesung)]='\0';
 	
+	/////////////////////////////////
+	
 	printf("Du hast 11 Versuche!\n");
 	printf("Auf das Raten fertig los!\n\n");
 	printf(striche);
 	printf("\n");
 	
+	/*
+	 * Schleife, die 11 mal durchlaufen wird --> 11 Versuche
+	 */
+	
 	for(z=1; z < 12;) {
-		ausgabe(versuch,0);
 		
-		eing = readline("Dein Versuch: ");
+		/*
+		 * Methode 'ausgabe(int versuch1, bool a)' ausführen
+		 */
+		ausgabe(versuch,0);
 		
 		treffer = false;
 		
+		/*
+		 * Versuch einlesen und ueberpruefen ob etwas eingegeben wurde
+		 * und ob die Eingabe = der Loesung ist.
+		 * Sonst wird der eingegebene Buchstabe 'entschluesselt'
+		 * und spaeter auch angezeigt.
+		 */
+		eing = readline("Dein Versuch: ");
+		
 		k = strlen(eing);
 		
 		if ((k>1 && strcmp(loesung,eing)!=0) || eing == NULL) {
@@ -117,36 +154,53 @@ int main(int argc, char** argv)
             } 
 		}
 		
+		/*
+		 * Wenn man nicht richtig liegt hat man einen Versuch weniger.
+		 */
+		
 		if (treffer==false) {
 			z++;
 			versuch--;
 		}
 		
+		/*
+		 * Ausgabe des 'verschluesselten' bzw. teilweise 'entschluesselten' Wortes
+		 */
 		printf("\n");
 		printf(striche);
 		printf("\n\n");
 		
+		/*
+		 * Bei Erfolg wird die Schleife unterbrochen und eine schöne Nachricht ausgegeben.
+		 */
+		
 		if (strcmp (loesung,striche)==0 || strcmp(loesung,eing)==0 ) {
 			printf("Glueckwunsch\n\n");
 			printf(striche);
 			printf("  war die Loesung\n\n");
 			break;
-		}
-		
-		
+		}	
 	}
 	
+	/*
+	 * Funktion 'ausgabe' ein letztes Mal aufgerufen.
+	 * 'eing' und 'loesung' freigegeben.
+	 */
 	ausgabe(versuch,1);
 	free(eing);
 	free(loesung);
 	
+	// Programm erfolgreich beenden.
 	return 0;
 }
 
 void ausgabe(int versuch1, bool a)
 {
-	// Anzahl der Versuche überprüfen + Hangman ausgeben
-	if (versuch1 == 11) {
+	/*
+	 * Anzahl der Versuche ueberpruefen + Hangman ausgeben
+	 */
+	 
+	if (versuch1 == 11 && a == 0) {
 		printf("               \n");
 		printf("               \n");
 		printf("               \n");
@@ -154,7 +208,7 @@ void ausgabe(int versuch1, bool a)
 		printf("               \n");
 		printf("               \n");
 	}
-	if(versuch1 == 10) {
+	if(versuch1 == 10 && a == 0) {
 		printf("               \n");
 		printf("               \n");
 		printf("               \n");
@@ -162,7 +216,7 @@ void ausgabe(int versuch1, bool a)
 		printf("               \n");
 		printf("     _|_       \n");
 	}
-	if(versuch1 == 9) {
+	if(versuch1 == 9 && a == 0) {
 		printf("               \n");
 		printf("      |        \n");
 		printf("      |        \n");
@@ -170,7 +224,7 @@ void ausgabe(int versuch1, bool a)
 		printf("      |        \n");
 		printf("     _|_       \n");
 	}
-	if(versuch1 == 8) {
+	if(versuch1 == 8 && a == 0) {
 		printf("      _______  \n");
 		printf("      |        \n");
 		printf("      |        \n");
@@ -178,7 +232,7 @@ void ausgabe(int versuch1, bool a)
 		printf("      |        \n");
 		printf("     _|_       \n");
 	}
-	if(versuch1 == 7) {
+	if(versuch1 == 7 && a == 0) {
 		printf("      _______  \n");
 		printf("      |/       \n");
 		printf("      |        \n");
@@ -186,7 +240,7 @@ void ausgabe(int versuch1, bool a)
 		printf("      |        \n");
 		printf("     _|_       \n");
 	}
-	else if(versuch1 == 6) {
+	if(versuch1 == 6 && a == 0) {
 		printf("      _______  \n");
 		printf("      |/    |  \n");
 		printf("      |        \n");
@@ -194,7 +248,7 @@ void ausgabe(int versuch1, bool a)
 		printf("      |        \n");
 		printf("     _|_       \n");
 	}
-	if(versuch1 == 5) {
+	if(versuch1 == 5 && a == 0) {
 		printf("      _______  \n");
 		printf("      |/    |  \n");
 		printf("      |     O  \n");
@@ -202,7 +256,7 @@ void ausgabe(int versuch1, bool a)
 		printf("      |        \n");
 		printf("     _|_       \n");
 	}
-	if(versuch1 == 4) {
+	if(versuch1 == 4 && a == 0) {
 		printf("      _______  \n");
 		printf("      |/    |  \n");
 		printf("      |     O  \n");
@@ -210,7 +264,7 @@ void ausgabe(int versuch1, bool a)
 		printf("      |        \n");
 		printf("     _|_       \n");
 	}
-	if(versuch1 == 3) {
+	if(versuch1 == 3 && a == 0) {
 		printf("      _______  \n");
 		printf("      |/    |  \n");
 		printf("      |     O/ \n");
@@ -218,7 +272,7 @@ void ausgabe(int versuch1, bool a)
 		printf("      |        \n");
 		printf("     _|_       \n");
 	}
-	if(versuch1 == 2) {
+	if(versuch1 == 2 && a == 0) {
 		printf("      _______  \n");
 		printf("      |/    |  \n");
 		printf("      |     O/ \n");
@@ -226,7 +280,7 @@ void ausgabe(int versuch1, bool a)
 		printf("      |        \n");
 		printf("     _|_       \n");
 	}
-	if(versuch1 == 1) {
+	if(versuch1 == 1 && a == 0) {
 		printf("      _______  \n");
 		printf("      |/    |  \n");
 		printf("      |     O/ \n");
@@ -235,7 +289,7 @@ void ausgabe(int versuch1, bool a)
 		printf("     _|_       \n");
 	}
 	
-	if(versuch1 == 0) {
+	if(versuch1 == 0 && a == 0) {
 		printf("      _______  \n");
 		printf("      |/    |  \n");
 		printf("      |     O/ \n");
@@ -244,6 +298,9 @@ void ausgabe(int versuch1, bool a)
 		printf("     _|_       \n");
 	}
 	
+	/*
+	 * Loesung anzeigen wenn man es nicht in 11 Versuche geschafft hat. Sonst 'Glueckwunsch!'
+	 */
 	if(versuch1>0 && a==1) {
 		printf("Glueckwunsch!\n");
 	}
-- 
1.7.1
