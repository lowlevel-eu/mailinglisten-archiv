 void con_init()
 {
+    // Ports fuer die serielle Schnittstelle reservieren
+    if (!request_ports(0x3F8, 1)) {
+        serial_output = FALSE;
+    }
+    if (serial_output && !request_ports(0x3FD, 1)) {
+        serial_output = FALSE;
+        release_ports(0x3F8, 1);
+    }
