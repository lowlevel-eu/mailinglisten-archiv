 src/kernel2/include/im.h          |  128 ++--
 src/kernel2/include/multiboot.h   |  376 ++++++------
 src/kernel2/include/smp.h         |   86 ++--
 src/kernel2/src/module.mk         |   32 +-
 src/kernel2/src/pv.c              |    8 +-
